#!/bin/sh

# Shared workstation setup; other machines keep ordinary wrapper behavior.
if [ "${GITHUB_ACTIONS:-}" != true ] && [ "${ANDROID_SHARED_DISABLE:-}" != 1 ] &&
    [ -r /opt/android-shared/environment.sh ]; then
    . /opt/android-shared/environment.sh
fi

#
